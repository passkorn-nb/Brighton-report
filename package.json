{
    "name": "kcis-report-service",
    "version": "1.0.0",
    "module": "src/index.js",
    "scripts": {
        "watch": "bun run --watch src/server.ts",
        "build": "bun build src/server.ts --outdir=dist --target=bun",
        "test": "bun test tests",
        "prod:start": "bun run build && pm2 start ecosystem.config.js",
        "prod:stop": "pm2 stop kcis-report",
        "prod:restart": "bun run build && pm2 restart kcis-report",
        "prod:logs": "pm2 logs kcis-report",
        "prod:flush": "pm2 flush kcis-report"
    },
    "dependencies": {
        "@elysiajs/cors": "^1.4.1",
        "@elysiajs/openapi": "^1.4.14",
        "axios": "^1.13.6",
        "dayjs": "^1.11.20",
        "elysia": "latest",
        "jsonwebtoken": "^9.0.3",
        "pdfmake": "^0.3.7",
        "winston": "^3.19.0",
        "winston-daily-rotate-file": "^5.0.0"
    },
    "devDependencies": {
        "@types/jsonwebtoken": "^9.0.10",
        "@types/pdfmake": "^0.3.2",
        "bun-types": "latest"
    },
    "prettier": {
        "semi": false,
        "singleQuote": true,
        "printWidth": 120,
        "tabWidth": 4,
        "trailingComma": "none",
        "bracketSpacing": true,
        "arrowParens": "avoid"
    }
}
